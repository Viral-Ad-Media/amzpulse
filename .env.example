# Public build-time backend origin, without /api. Empty uses Vite's localhost:3001
# proxy in development; static production hosting requires an HTTPS backend origin.
VITE_API_BASE=

# Optional Vercel same-origin gateway (runtime server setting). Set this instead of
# VITE_API_BASE when using the gateway. Provider/database secrets belong in the backend.
AMZPULSE_BACKEND_URL=
